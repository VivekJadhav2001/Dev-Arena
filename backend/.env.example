# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=2001
MONGODB_URI=mongodb://localhost:27017/devarena
FRONTEND_URL=http://localhost:5173
# Must be 32+ characters in production.
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:2001/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:2001/api/v1/auth/google/callback
# Optional: self-hosted Judge0 URL for code execution.
JUDGE0_API_URL=https://ce.judge0.com
